# Supabase — create a new project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail SMTP — auth & notification emails
SMTP_EMAIL=qrzinfo@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# Admin notification inbox (comma-separated for multiple admins)
NOTIFY_EMAIL=qrzinfo@gmail.com,eHamHub@gmail.com

# Super-admin email(s) — comma-separated
ADMIN_EMAIL=qrzinfo@gmail.com,eHamHub@gmail.com

# Optional — Open Repeater directory (www.openrepeater.org)
OPENREPEATER_SITE=https://www.openrepeater.org
# Direct read from Open Repeater Supabase (recommended — same DB as openrepeater.org)
OPENREPEATER_SUPABASE_URL=
OPENREPEATER_SUPABASE_SERVICE_ROLE_KEY=
# Or use the v1 API with a key from openrepeater.org/api-docs
OPENREPEATER_API_BASE_URL=https://www.openrepeater.org/api/v1
OPENREPEATER_API_KEY=
