# Supabase — create a new project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail SMTP — auth & notification emails
SMTP_EMAIL=qrzinfo@gmail.com
SMTP_APP_PASSWORD=your-gmail-app-password

# Admin notification inbox
NOTIFY_EMAIL=qrzinfo@gmail.com

# Super-admin email(s)
ADMIN_EMAIL=qrzinfo@gmail.com

# Optional — for live Open Repeater API (otherwise uses public JSON download)
OPENREPEATER_API_BASE_URL=https://www.openrepeater.org/api/v1
OPENREPEATER_API_KEY=
